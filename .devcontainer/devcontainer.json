{
  "name": "FullStackJS-102",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24-bookworm",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Node.js Web Server",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "files.autoSave": "afterDelay"
      },
      "extensions": [
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
